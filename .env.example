# IUB Class Management System — environment variables
# Copy to .env for local development. NEVER commit real values.

NODE_ENV=development

# MongoDB Atlas (production database)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/iubcrlms

# Auth secrets — generate with: openssl rand -hex 32
JWT_SECRET=replace-with-long-random-string
ATTENDANCE_SECRET=replace-with-long-random-string

# Admin bootstrap (set on Vercel in production)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Brevo transactional email (HTTP API — no SMTP)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Brevo transactional email (OTP) — later phase
BREVO_API_KEY=

# Cloudinary — later phase
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: comma-separated allowed CORS origins for local dev (same-origin in production; leave empty)
CORS_ORIGIN=
