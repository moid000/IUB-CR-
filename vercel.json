{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60
      }
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/frontend/(.*)",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/((?!frontend/|api/|frontend$).*)",
      "destination": "/frontend/index.html"
    }
  ],
  "regions": [
    "bom1"
  ]
}